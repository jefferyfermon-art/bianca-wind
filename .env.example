# Contact form delivery.
# All three must be set for the contact form to render and send.
# Without them the contact page shows an honest "not open yet" note instead.
RESEND_API_KEY=
CONTACT_INBOX=
CONTACT_FROM=

# Optional: canonical site origin for metadata, sitemap.xml and robots.txt.
# On Vercel this is detected automatically; set it only to override.
# NEXT_PUBLIC_SITE_URL=https://example.com


# ---------------------------------------------------------------------------
# SMS relay (/sms and /api/sms-webhook)
# ---------------------------------------------------------------------------
# Pass-through only. No message is stored anywhere by this app.
#
# Set every value below in the Vercel project settings as well as here, or the
# relay returns 503 in production. None of these may be prefixed NEXT_PUBLIC_:
# only PUSHER_KEY and PUSHER_CLUSTER reach the browser, and they are passed
# through the server component as props rather than inlined at build time.

# From the Pusher Channels app dashboard (App Keys).
PUSHER_APP_ID=1234567
PUSHER_KEY=00000000000000000000
PUSHER_SECRET=00000000000000000000
PUSHER_CLUSTER=eu

# Shared secret the iOS Shortcut sends as the X-Webhook-Secret header.
# Generate one, for example: openssl rand -hex 32
SMS_WEBHOOK_SECRET=replace-with-a-long-random-string

# HTTP Basic Auth for the /sms page and the channel auth endpoint.
SMS_PAGE_USER=relay
SMS_PAGE_PASSWORD=replace-with-a-long-random-password
